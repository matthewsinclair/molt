# macOS filesystem artifacts (leak through Parallels mount)
.DS_Store
Icon?

# Ignore intent upgrade backups
.backup/backup-*

# AGENTS.md regeneration safety net (intent agents sync writes this; transient).
/AGENTS.md.bak

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json

# Treeindex cache (derived, machine-local; regenerate with 'intent treeindex <dir>').
intent/.treeindex/

# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# D53: the event log lives in the store; its file form is produced by `intent export`.
intent/.backup/

# Intent's installer owns the hook carriers it writes beside each dispatcher.
.githooks/*.intent

# devbin's gate seals and logs and its release scratch (tmp/check, tmp/test, tmp/release).
/tmp/

# An Intent view of many records: every clone renders its own from the store, so none is committed.
intent/st/steel_threads.md

# An Intent view of many records: every clone renders its own from the store, so none is committed.
intent/todo.md

# An Intent view of many records: every clone renders its own from the store, so none is committed.
intent/st/*/acceptance.md
