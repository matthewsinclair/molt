{
  "permissions": {
    "deny": ["Edit(/AGENTS.md)", "Edit(/.claude/AGENTS.md)"],
    "allow": ["Bash(intent wp:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "intent claude hook session-context",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "intent claude hook require-in-session",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "intent claude hook session-finish",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "p=''; command -v jq >/dev/null 2>&1 && p=\"$(jq -r '.tool_input.file_path // empty' 2>/dev/null)\"; [ -n \"$p\" ] || p=\"${CLAUDE_FILE_PATH:-}\"; p=\"${p#\"${CLAUDE_PROJECT_DIR:-$PWD}\"/}\"; if [ -n \"$p\" ] && [ -f intent/llm/MODULES.md ] && ! grep -qF \"$p\" intent/llm/MODULES.md 2>/dev/null; then echo \"Advisory: $p is not registered in MODULES.md. Run 'intent modules check' to review.\"; fi; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["intent"]
}
