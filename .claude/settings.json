{
  "permissions": {
    "deny": ["Edit(/AGENTS.md)", "Edit(/.claude/AGENTS.md)"],
    "allow": ["Bash(intent wp:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "intent claude hook session-context",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "intent claude hook require-in-session",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "intent claude hook session-finish",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f intent/llm/MODULES.md ] && ! grep -qF \"$CLAUDE_FILE_PATH\" intent/llm/MODULES.md 2>/dev/null; then echo \"Advisory: $CLAUDE_FILE_PATH is not registered in MODULES.md. Run 'intent modules check' to review.\"; fi",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["intent"]
}
