#!/usr/bin/env bash
# molt — My Opinionated Local Terminal
# Thin coordinator: parse args, delegate to lib functions.

set -euo pipefail

# Resolve symlinks so MOLT_ROOT works when invoked via the ~/.local/bin/molt symlink, a
# relative target read from its link's directory. lib/molt.sh's _molt_realpath
# does this for everything else, but cannot be sourced before MOLT_ROOT is known.
_molt_self="${BASH_SOURCE[0]}"
while [[ -L "$_molt_self" ]]; do
  _molt_link="$(readlink "$_molt_self")"
  case "$_molt_link" in
    /*) _molt_self="$_molt_link" ;;
    *) _molt_self="$(dirname "$_molt_self")/$_molt_link" ;;
  esac
done
MOLT_ROOT="$(cd "$(dirname "$_molt_self")/.." && pwd)"
unset _molt_self _molt_link

# Source core libraries
# shellcheck disable=SC1091
source "${MOLT_ROOT}/lib/molt.sh"
# shellcheck disable=SC1091
source "${MOLT_ROOT}/lib/liberator.sh"
# shellcheck disable=SC1091
source "${MOLT_ROOT}/lib/newuser.sh"
# shellcheck disable=SC1091
source "${MOLT_ROOT}/lib/agent.sh"
# shellcheck disable=SC1091
source "${MOLT_ROOT}/lib/install.sh"
# shellcheck disable=SC1091
source "${MOLT_ROOT}/lib/env.sh"

# --- Commands ---

cmd_help() {
  cat <<EOF
${MOLT_NAME} v${MOLT_VERSION} — My Opinionated Local Terminal
Your shell config is your identity. Every new machine is just a new body.

Usage: molt <command> [args]

Commands:
  resleeve [--dry-run]  Bootstrap the current machine from your stack
  upgrade [--self] [--dry-run] [--no-pull] [liberators] [--resleeve|--no-resleeve]
                        --self: pull framework + config repos only (no hooks)
                        --no-pull: skip the pull (molt upgrade restarts itself with it
                        after a pull that moved the framework)
                        Pull latest, run upgrade hooks, then resleeve
                        With liberators: upgrade only those (comma-separated)
                        Default: resleeve after full upgrade, no resleeve after targeted
  maintain [--dry-run] [liberators]
                        Run system maintenance (brew update, doom upgrade, etc.)
                        With liberators: maintain only those (comma-separated)
  new-user <user> [--name N] [--email E] [--github GH] [--hostname H] [--dest DIR]
                        Scaffold a new molt-{user} config repo from the skeleton.
                        Prompts for anything not passed as a flag.
  install [--prefix DIR] [--force] [--managed-by molt|brew]
                        Publish this dev tree to DIR (default: MOLT_INSTALL_PREFIX
                        in vars.sh) as the opt tree, with a manifest
  use [dev|opt|brew]   Link ~/.local/bin/molt to dev or opt, or remove it for brew; with none, show what serves molt
  status      Show current sleeve state and liberator status
  list        List liberators with enabled/disabled/installed status
  agent list  List this sleeve's agents: name, role, enabled, state, home
  agent roles List the roles this sleeve declares, one a line
  agent start <role> [-- <claude args>]
                        Start the agent in its home, as
                        claude start --name <hostname>-<role>
  agent home <role>
                        Print the agent's home
  agent config <role>
                        Show an agent's home, its files' state, the settings
                        read for it and its permission rules, by layer
                        (an agent is named by its role, or <hostname>-<role>)
  git <cmd>    Run a git command across all managed repos
  doctor      System diagnostics and health checks
  test        Run bats test suite (molt test [liberator])
  version     Show the version, the tree (dev, opt or brew) and its commit
  help        Show this help message

EOF
}

cmd_status() {
  echo "${MOLT_NAME} v${MOLT_VERSION}"
  echo ""
  echo "Sleeve: $(molt_hostname)"
  echo "Platform: $(molt_platform)"
  echo "Distro: $(molt_distro)"
  echo "Arch: $(molt_arch)"
  echo ""

  local user_repo
  user_repo="$(molt_find_user_repo 2>/dev/null || echo "")"
  if [[ -n "$user_repo" ]]; then
    echo "Stack: $user_repo"
  else
    echo "Stack: not found"
  fi

  echo ""
  echo "Liberators:"
  local libs=()
  while IFS= read -r lib; do
    [[ -n "$lib" ]] && libs+=("$lib")
  done < <(liberator_list)
  liberator_status_all "${libs[@]}"
}

# Every argument is read before anything else is, and one resleeve does not
# take, flag or word, is refused. It used to look only at its first, and only
# for --dry-run, so --help, -h and a --dryrun typo each ran a real resleeve
# (issue 0070).
cmd_resleeve() {
  local dry_run=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      *)
        molt_error "Unknown option: $1"
        return 1
        ;;
    esac
  done
  molt_resleeve "$dry_run" true
}

# --- Main ---

case "${1:-help}" in
  resleeve) shift; cmd_resleeve "$@" ;;
  upgrade)  shift; cmd_upgrade "$@" ;;
  maintain) shift; cmd_maintain "$@" ;;
  install)  shift; cmd_install "$@" ;;
  use)      shift; cmd_use "$@" ;;
  new-user) shift; cmd_new_user "$@" ;;
  git)      shift; cmd_git "$@" ;;
  status)   cmd_status ;;
  list)     cmd_list ;;
  agent)    shift; cmd_agent "$@" ;;
  doctor)   cmd_doctor ;;
  test)     shift; cmd_test "$@" ;;
  version|--version) molt_version_line ;;
  help)     cmd_help ;;
  *)
    molt_error "Unknown command: $1"
    cmd_help
    exit 1
    ;;
esac
