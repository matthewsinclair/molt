# molt.toml — Stack manifest for MOLT
# The authoritative source of truth for what your stack contains.
#
# Each liberator has an "enabled" flag. Set to false to skip it.
# Only the liberators listed and enabled for this platform run; one that is not
# listed does not run. A manifest that enables none for this platform runs
# every liberator Molt ships, so enable at least one.

[stack]
name = "my-stack"                    # Your stack name (typically molt-{userid})
version = "0.1.0"
user_repo = "Molt-you"               # your config repo's directory, exact-case; molt doctor checks it

# --- Core liberators ---
# These handle the base environment.

[[liberator]]
name = "system"
enabled = true
os = ["linux"]

[[liberator]]
name = "local-bin"
enabled = true
os = ["linux", "macos"]

[[liberator]]
name = "zsh"
enabled = true
os = ["linux", "macos"]

[[liberator]]
name = "git"
enabled = true
os = ["linux", "macos"]

[[liberator]]
name = "tmux"
enabled = true
os = ["linux", "macos"]

[[liberator]]
name = "editors"
enabled = true
os = ["linux", "macos"]

[[liberator]]
name = "gnome-terminal"
enabled = true
os = ["linux"]

[[liberator]]
name = "terminal-app"
enabled = true
os = ["macos"]

[[liberator]]
name = "iterm2"
enabled = false                      # enable once iTerm2 is installed
os = ["macos"]

[[liberator]]
name = "alacritty"
enabled = false                      # enable once Alacritty is installed
os = ["linux", "macos"]

[[liberator]]
name = "keys"
enabled = false                      # parked — Cmd key passthrough issue
os = ["linux"]

[[liberator]]
name = "desktop"
enabled = true
os = ["linux"]

[[liberator]]
name = "dev-tools"
enabled = true
os = ["linux", "macos"]

[[liberator]]
name = "npm"
enabled = true
os = ["linux", "macos"]

[[liberator]]
name = "ssh"
enabled = true
os = ["linux", "macos"]

# --- Tool liberators ---
# These link dev tools from their repos into ~/.local/bin (MOLT_LOCAL_BIN).

[[liberator]]
name = "utilz"
enabled = true
os = ["linux", "macos"]
