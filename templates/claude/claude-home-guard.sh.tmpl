#!/bin/sh
# claude-home-guard.sh -- GENERATED by molt from templates/claude; do not edit.
#
# A UserPromptSubmit hook in Claude Code's user settings, and in each agent
# home's own settings. A sleeve agent runs from its own home under
# MOLT_AGT_DIR, which holds its role contract, its permissions and its memory
# (Molt ST0006). The guard refuses a session launched in $HOME, which has none
# of them, and one launched under the agents root but not in an agent home
# itself: Claude Code reads CLAUDE.md up the tree, but project settings only
# from the launch directory's .claude/, so a launch below a home keeps its
# contract and loses its fence. A session launched in an agent home, or
# anywhere else, passes.
#
# It also refuses a session that did not get the config dir this sleeve
# declares, as one started from a shell opened before the move does: it
# starts Claude Code afresh in $HOME, a second login and all. The user
# settings live in the config dir such a session missed, so only the home's
# copy of the hook sees it, and the guard lives outside any config dir, so
# either copy finds it (issue 0030). Hooks inherit the session's environment,
# so CLAUDE_CONFIG_DIR here is what the session read.
#
# Where a session was launched is CLAUDE_PROJECT_DIR, which Claude Code sets on
# the hook's process: the project root where the session started, which stays
# put when the session cds or enters a worktree. The cwd in the hook's JSON
# input follows those moves, so a test of it would refuse every prompt after a
# cd into $HOME, and the input is not read. Neither $HOME nor an agent home is
# a git repository, so for either the project root is the launch directory.
#
# Exit 2 blocks the prompt and shows stderr; any other non-zero exit shows
# stderr and blocks nothing. It needs nothing of molt's, nor anything beyond
# sh: molt need not be on PATH when a prompt is sent.
#
# Strict mode is off on purpose, and every step is checked by hand. The exit
# status is the verdict, and a strict-mode exit could land on 2: dash exits 2
# for an unset variable under set -u, which would block every prompt. Exit 2
# comes only from the launch tests and the config-dir test below.

# Drained unread, by the shell's own read, so Claude Code's write of the input
# always lands, with or without a cat on PATH.
if [ ! -t 0 ]; then
  while IFS= read -r _; do :; done
fi

# Each must be absolute: cd resolves a relative one against wherever the hook
# runs, which can make an agent home read as $HOME.
case "${CLAUDE_PROJECT_DIR:-}" in
  /*) ;;
  "")
    echo "claude-home-guard: the hook has no CLAUDE_PROJECT_DIR, so the launch directory was not checked" >&2
    exit 1 ;;
  *)
    echo "claude-home-guard: CLAUDE_PROJECT_DIR is not an absolute path, so the launch directory was not checked" >&2
    exit 1 ;;
esac
case "${HOME:-}" in
  /*) ;;
  "")
    echo "claude-home-guard: the hook has no HOME, so the launch directory was not checked" >&2
    exit 1 ;;
  *)
    echo "claude-home-guard: HOME is not an absolute path, so the launch directory was not checked" >&2
    exit 1 ;;
esac

# The agents root as molt rendered it, read from a quoted here-document so that
# no character in it is syntax here. _claude_guard_line in
# liberators/claude.sh reads it back from the line after the opener, and finds
# it only in this form.
IFS= read -r agt <<'MOLT_AGENTS_ROOT'
${MOLT_AGT_DIR}
MOLT_AGENTS_ROOT

# The directory $1 leads to, as the disk spells it, or nothing when it cannot
# be entered: a symlinked spelling, or one with a trailing slash, is the same
# directory. bash's builtin pwd -P keeps the letter case it was given, which on
# a case-insensitive disk need not be the disk's, so /bin/pwd answers, and the
# builtin only on a system without one. molt_disk_path in molt's lib/molt.sh
# resolves the same way, so molt_agt_dir_fault refuses a root this guard would
# take for HOME or for a parent of the projects.
real_dir() {
  (cd "$1" 2>/dev/null && { /bin/pwd -P 2>/dev/null || pwd -P; })
}

here="$(real_dir "$CLAUDE_PROJECT_DIR")" || here="$CLAUDE_PROJECT_DIR"
home="$(real_dir "$HOME")" || home="$HOME"

if [ "$here" = "$home" ]; then
  echo "launch from an agent home: molt agent list" >&2
  exit 2
fi

# molt renders only an absolute root and refuses any other, so a root that is
# empty or relative is a hand edit, and is not checked. A root that does not
# exist holds no launch directory.
case "$agt" in
  /*) root="$(real_dir "$agt")" || root="" ;;
  *) root="" ;;
esac
if [ -n "$root" ]; then
  case "$here" in
    "$root")
      echo "launch from an agent home, not the agents root: molt agent list" >&2
      exit 2 ;;
    "$root"/*/*)
      rest="${here#"$root"/}"
      echo "launch from the agent home itself: cd $agt/${rest%%/*}" >&2
      exit 2 ;;
  esac
fi

# The config dir this sleeve declares, as molt rendered it, read the same way
# as the agents root; _claude_guard_line reads it back. A sleeve that declares
# none renders no absolute path here, and the test is skipped.
IFS= read -r want <<'MOLT_CLAUDE_CONFIG_DIR'
${MOLT_CLAUDE_CONFIG_DIR}
MOLT_CLAUDE_CONFIG_DIR

case "$want" in
  /*)
    have="${CLAUDE_CONFIG_DIR:-}"
    if [ -z "$have" ]; then
      echo "this Claude Code did not get CLAUDE_CONFIG_DIR (want $want): quit it, open a new shell, or log out and in, and relaunch from the home" >&2
      exit 2
    fi
    wanted="$(real_dir "$want")" || wanted="$want"
    had="$(real_dir "$have")" || had="$have"
    if [ "$had" != "$wanted" ]; then
      echo "this Claude Code has CLAUDE_CONFIG_DIR $have, not $want: quit it, open a new shell, or log out and in, and relaunch from the home" >&2
      exit 2
    fi ;;
esac
exit 0
