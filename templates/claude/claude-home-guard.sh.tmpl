#!/bin/sh
# claude-home-guard.sh -- GENERATED by molt from templates/claude; do not edit.
#
# A UserPromptSubmit hook in Claude Code's user settings. It refuses a session
# whose working directory is $HOME: a sleeve agent runs from its own home under
# MOLT_AGT_DIR, which holds its role contract, its permissions and its memory,
# and a session in $HOME has none of them (Molt ST0006). Any other directory
# passes.
#
# Claude Code sends the hook's input as JSON on stdin. Exit 2 blocks the prompt
# and shows stderr; any other non-zero exit shows stderr and blocks nothing. It
# needs jq and nothing of molt's: molt need not be on PATH when a prompt is sent.
#
# Strict mode is off on purpose, and every step is checked by hand. The exit
# status is the verdict, and a strict-mode exit could land on 2: dash exits 2
# for an unset variable under set -u, which would block every prompt. Exit 2
# comes only from the $HOME test below.

if ! command -v jq >/dev/null 2>&1; then
  echo "claude-home-guard: jq is not on PATH, so the launch directory was not checked" >&2
  exit 1
fi

if ! cwd="$(jq -r '.cwd // empty' 2>/dev/null)"; then
  echo "claude-home-guard: the hook input is not JSON, so the launch directory was not checked" >&2
  exit 1
fi
if [ -z "$cwd" ]; then
  echo "claude-home-guard: the hook input names no cwd, so the launch directory was not checked" >&2
  exit 1
fi

# Compare where the two lead, so a symlinked spelling of $HOME, or one with a
# trailing slash, is still $HOME.
here="$(cd "$cwd" 2>/dev/null && pwd -P)" || here="$cwd"
home="$(cd "$HOME" 2>/dev/null && pwd -P)" || home="$HOME"

if [ "$here" = "$home" ]; then
  echo "launch from an agent home: molt agent list" >&2
  exit 2
fi
exit 0
