#!/bin/sh
# claude-home-guard.sh -- GENERATED by molt from templates/claude; do not edit.
#
# A UserPromptSubmit hook in Claude Code's user settings. It refuses a session
# launched in $HOME: a sleeve agent runs from its own home under MOLT_AGT_DIR,
# which holds its role contract, its permissions and its memory, and a session
# launched in $HOME has none of them (Molt ST0006). A session launched anywhere
# else passes.
#
# Where a session was launched is CLAUDE_PROJECT_DIR, which Claude Code sets on
# the hook's process: the project root where the session started, which stays
# put when the session cds or enters a worktree. The cwd in the hook's JSON
# input follows those moves, so a test of it would refuse every prompt after a
# cd into $HOME, and the input is not read. Neither $HOME nor an agent home is
# a git repository, so for either the project root is the launch directory.
#
# Exit 2 blocks the prompt and shows stderr; any other non-zero exit shows
# stderr and blocks nothing. It needs nothing of molt's, nor anything beyond
# sh: molt need not be on PATH when a prompt is sent.
#
# Strict mode is off on purpose, and every step is checked by hand. The exit
# status is the verdict, and a strict-mode exit could land on 2: dash exits 2
# for an unset variable under set -u, which would block every prompt. Exit 2
# comes only from the $HOME test below.

# Drained unread, by the shell's own read, so Claude Code's write of the input
# always lands, with or without a cat on PATH.
if [ ! -t 0 ]; then
  while IFS= read -r _; do :; done
fi

# Each must be absolute: cd resolves a relative one against wherever the hook
# runs, which can make an agent home read as $HOME.
case "${CLAUDE_PROJECT_DIR:-}" in
  /*) ;;
  "")
    echo "claude-home-guard: the hook has no CLAUDE_PROJECT_DIR, so the launch directory was not checked" >&2
    exit 1 ;;
  *)
    echo "claude-home-guard: CLAUDE_PROJECT_DIR is not an absolute path, so the launch directory was not checked" >&2
    exit 1 ;;
esac
case "${HOME:-}" in
  /*) ;;
  "")
    echo "claude-home-guard: the hook has no HOME, so the launch directory was not checked" >&2
    exit 1 ;;
  *)
    echo "claude-home-guard: HOME is not an absolute path, so the launch directory was not checked" >&2
    exit 1 ;;
esac

# Compare where the two lead, so a symlinked spelling of $HOME, or one with a
# trailing slash, is still $HOME.
here="$(cd "$CLAUDE_PROJECT_DIR" 2>/dev/null && pwd -P)" || here="$CLAUDE_PROJECT_DIR"
home="$(cd "$HOME" 2>/dev/null && pwd -P)" || home="$HOME"

if [ "$here" = "$home" ]; then
  echo "launch from an agent home: molt agent list" >&2
  exit 2
fi
exit 0
