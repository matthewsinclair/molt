#!/usr/bin/env bash

# intent-chain-block:start (generated by intent claude upgrade)
_intent_hooks="$(git rev-parse --git-path hooks 2>/dev/null || :)"
_intent_chain="$_intent_hooks/pre-commit.intent"
_intent_own=""
case "$_intent_hooks" in
  /* | "") ;;
  *)
    _intent_common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || :)"
    if [ ! -e "$_intent_chain" ] && [ -n "$_intent_common" ] &&
      [ "$_intent_common" != "$(git rev-parse --path-format=absolute --git-dir 2>/dev/null || :)" ]; then
      _intent_own="$_intent_chain"
      _intent_chain="${_intent_common%/*}/$_intent_chain"
    fi
    ;;
esac
if [ -x "$_intent_chain" ]; then
  "$_intent_chain" "$@" || exit $?
elif [ -e "$_intent_chain" ]; then
  echo "pre-commit: GATE NOT EXECUTABLE -- the Intent gate did NOT run: no guard, no critic, no doctor." >&2
  echo "pre-commit:   the carrier has no execute bit: $_intent_chain" >&2
  echo "pre-commit:   remedy: intent claude upgrade --apply" >&2
  exit 1
else
  echo "pre-commit: GATE ABSENT -- the Intent gate did NOT run: no guard, no critic, no doctor." >&2
  echo "pre-commit:   this hook declares a gate it cannot find: $_intent_chain" >&2
  if [ -n "$_intent_own" ]; then
    echo "pre-commit:   nor at this worktree's own hooks path: $_intent_own" >&2
  fi
  echo "pre-commit:   the carrier is gitignored, so no clone or worktree receives it." >&2
  if [ -n "$_intent_own" ]; then
    echo "pre-commit:   remedy: intent claude upgrade --apply, in the main checkout ${_intent_common%/*}" >&2
  else
    echo "pre-commit:   remedy: intent claude upgrade --apply" >&2
  fi
  exit 1
fi
# intent-chain-block:end
